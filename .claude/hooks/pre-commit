#!/usr/bin/env bash
# .claude/hooks/pre-commit — syndicate framework commit guard (MECHANICAL).
#
# Git runs this on EVERY `git commit`, regardless of how files were staged, so it
# catches the outcome of `git add -A` no matter what the agent remembered. It
# REJECTS a commit whose staged set NEWLY ADDS a build artifact, an oversize
# blob, or a file that looks like it holds a secret (named .env or .env.<x>, or
# carrying a private key or an AWS secret access key — PROJECT_CHARTER.md § 8).
# Those checks NEVER inspect modifications/deletions of already-tracked files — that
# is what lets a legitimately-tracked large data file (e.g. a 34MB curator .tsv)
# keep committing while a brand-new 36MB lambda-deployment.zip is blocked.
# It also NOTES, never refuses, a staged skill or command whose frontmatter an
# executor may not read (description: not on one line, or a fence never closed).
#
# CANONICAL: edit ONLY at _project-template/.claude/hooks/pre-commit in
# syndicate-playbooks-examples, then run /distribute-defaults. Do NOT hand-edit
# project copies — the per-project variance point is artifact-guard.allow.
#
# Wired via repo-local `git config core.hooksPath .claude/hooks` (set by /setup,
# /setup-workflow-only, the distribute engine, and re-affirmed by /start-session). Never copied into
# .git/hooks (that would rot and not travel with the repo).
#
# Escape valves (so the guard is not bypassed wholesale):
#   - .claude/hooks/artifact-guard.allow : committed glob allowlist (the right way).
#   - git commit --no-verify             : standard one-off override (rare, audited).
set -u

# Size backstop for UN-patterned blobs. High on purpose: true artifacts match the
# patterns below; a low threshold only creates false positives on legit large data.
# Override per-repo with env GUARD_MAX_BYTES.
MAX_BYTES="${GUARD_MAX_BYTES:-26214400}"   # 25 MiB

# Base to diff against; empty-tree sha when there is no HEAD yet → works on the
# very first commit.
if git rev-parse -q --verify HEAD >/dev/null 2>&1; then
  BASE="HEAD"
else
  BASE="$(git hash-object -t tree /dev/null)"   # 4b825dc642cb6eb9a060e54bf8d69288fbee4904
fi

# Allowlist content: read from the INDEX when it is staged (so an entry added in
# THIS commit is authoritative and travels with the commit), else the working
# tree, else empty. Avoids the staged-vs-worktree exemption race.
allow_content() {
  if git diff --cached --name-only -- .claude/hooks/artifact-guard.allow 2>/dev/null | grep -q .; then
    git show ":.claude/hooks/artifact-guard.allow" 2>/dev/null
  elif [ -f .claude/hooks/artifact-guard.allow ]; then
    cat .claude/hooks/artifact-guard.allow 2>/dev/null
  fi
}

# Glob-match a path against the allowlist (gitignore-style globs; # comments + blanks ok).
is_allowed() {
  local path="$1" line
  while IFS= read -r line; do
    line="${line%$'\r'}"                      # tolerate CRLF allowlists
    case "$line" in ''|\#*) continue ;; esac
    # In `case`, * matches across '/', so docs/phase-*/*.tsv works as intended.
    # shellcheck disable=SC2254
    case "$path" in
      $line) return 0 ;;
      */$line) return 0 ;;                    # also match a bare basename glob anywhere
    esac
  done <<EOF
$(allow_content)
EOF
  return 1
}

# Artifact patterns matched at ANY size (case-insensitive).
ARTIFACT_EXT='\.(zip|tar|tar\.gz|tgz|tar\.bz2|jar|war|whl|egg|pyc|pyo|class|tfstate|tfstate\.backup)$'
ARTIFACT_DIR='(^|/)(__pycache__|node_modules|dist|build|cdk\.out|\.terraform|target|\.pytest_cache|\.venv|venv|coverage)/'
ARTIFACT_EGG='(^|/)[^/]*\.egg-info(/|$)'
# Compiled-object / opaque-binary patterns — GATED behind size so a small legit
# vendored lib or binary test fixture is not blocked.
ARTIFACT_BIN='\.(so|o|dylib|dll|exe|bin)$'

# Secrets in NEWLY-ADDED files (PROJECT_CHARTER.md § 8). A gitignored secret is one forced add away
# from history: `git add -f .env` used to commit cleanly, because this guard asked new paths only
# about artifacts, size and .codex/. History keeps a secret after the file is deleted, so the only
# cheap moment to stop one is this commit. A path is flagged when
#   (a) its basename is .env or .env.<x>, unless it ends in .example/.sample/.template/.dist; or
#   (b) its staged blob is at most 1 MiB and has a line carrying a PEM private-key header, or an
#       aws_secret_access_key assigned a 40-character value on a line without EXAMPLE.
# The 40 characters are what make (b) safe: a bare `= …` form matched boto3 keyword arguments
# (aws_secret_access_key=creds["SecretAccessKey"],) and placeholder docs across the estate. Run
# over every local project on 2026-10-22, the tightened pattern hit exactly one tracked file.
# Evaluated AFTER is_allowed, so a fake fixture listed in artifact-guard.allow passes. The message
# names the path and the cause, never the matching line. If git cannot read the blob, the check
# fails open.
# A blob that names neither marker (any case) is read once and passes; only one that does is read
# again for the exact patterns.
# Known limits, measured 2026-10-22. The PEM header matches anywhere on a line, so source code that
# holds it as a string constant is refused too: the cryptography library's ssh.py does, so a newly
# vendored crypto library or Python Lambda layer needs an artifact-guard.allow line. The pattern
# ends at "PRIVATE KEY-----", so a PGP key block (BEGIN PGP PRIVATE KEY BLOCK) and a PuTTY .ppk
# key are not caught.
SECRET_SCAN_MAX=1048576   # 1 MiB; larger blobs are not read
SECRET_PEM='-----BEGIN ([A-Z]+ )*PRIVATE KEY-----'
SECRET_AWS="aws_secret_access_key[\"']?[[:space:]]*[=:][[:space:]]*[\"']?[A-Za-z0-9/+]{40}[\"']?,?[[:space:]]*\$"
secret_cause() {
  local path="$1" base="${1##*/}" sz
  case "$base" in
    .env|.env.?*)
      case "$base" in
        *.example|*.sample|*.template|*.dist) ;;
        *) echo "named like a secret file"; return 0 ;;
      esac ;;
  esac
  sz="$(git cat-file -s ":$path" 2>/dev/null)" || return 0
  case "$sz" in ''|*[!0-9]*) return 0 ;; esac
  [ "$sz" -le "$SECRET_SCAN_MAX" ] || return 0
  git cat-file -p ":$path" 2>/dev/null \
    | grep -qaiE -e 'PRIVATE KEY-----' -e 'aws_secret_access_key' || return 0
  if git cat-file -p ":$path" 2>/dev/null | grep -qaE -e "$SECRET_PEM"; then
    echo "contains a private key"
  elif git cat-file -p ":$path" 2>/dev/null | grep -aiE -e "$SECRET_AWS" | grep -qav 'EXAMPLE'; then
    echo "contains an AWS secret access key"
  fi
  return 0
}

violations=""
secret_violations=""

# Enumerate ONLY newly-ADDED staged paths. --name-only -z --diff-filter=A emits
# plain NUL-separated paths (no status field, no rename pairs) → unambiguous parse.
while IFS= read -r -d '' path; do
  [ -n "$path" ] || continue

  # A tracked .codex/ directory is NOT a build artifact, and it is evaluated BEFORE is_allowed on
  # purpose: a one-line artifact-guard.allow entry must not be able to exempt it. Codex loads
  # <project>/.codex/config.toml in a trusted checkout and EXECUTES its [mcp_servers.*] commands
  # at session start — so a committed .codex/ turns `git pull` into a code-execution channel for
  # every host that trusts the project. Measured 2026-08-25 (consult-loop design, invariant I4).
  # Codex configuration in this estate is per-host ($CODEX_HOME) or per-invocation (-c flags);
  # it is never a project file. Override is the same audited --no-verify as everything else.
  if printf '%s' "$path" | grep -qE '(^|/)\.codex/'; then
    violations="${violations}  ${path}  (NEW, a tracked .codex/ directory — Codex executes its mcp_servers commands on pull in a trusted checkout; Codex config is per-host or per-invocation, never committed)
"
    continue
  fi

  is_allowed "$path" && continue

  cause="$(secret_cause "$path")"
  [ -n "$cause" ] && secret_violations="${secret_violations}  ${path}  (${cause})
"

  reason=""
  if printf '%s' "$path" | grep -qiE "$ARTIFACT_EXT" \
     || printf '%s' "$path" | grep -qiE "$ARTIFACT_DIR" \
     || printf '%s' "$path" | grep -qiE "$ARTIFACT_EGG"; then
    reason="matches build-artifact pattern"
  fi

  if [ -z "$reason" ]; then
    sz="$(git cat-file -s ":$path" 2>/dev/null || echo 0)"
    if printf '%s' "$path" | grep -qiE "$ARTIFACT_BIN" && [ "${sz:-0}" -gt "$MAX_BYTES" ]; then
      reason="compiled/binary > $((MAX_BYTES/1048576)) MiB"
    elif [ "${sz:-0}" -gt "$MAX_BYTES" ]; then
      reason="$(( sz / 1048576 )) MiB > $((MAX_BYTES/1048576)) MiB limit"
    fi
  fi

  [ -n "$reason" ] && violations="${violations}  ${path}  (NEW, ${reason})
"
done < <(git diff --cached --name-only -z --diff-filter=A "$BASE" 2>/dev/null)

# ---------------------------------------------------------------------------
# Skill naming — a NEW skill or command this project creates ends in -<project code>.
#
# A project's .claude/skills/, .agents/skills/ and .claude/commands/ mix what arrives by
# distribution with what the project wrote itself, and Claude Code lists both as skills beside
# the ones its installation brings. The operator's rule (2026-10-16): a project's own skill names
# its project code as a SUFFIX — "user starts typing and want hits not repeating prefix" — so the
# skill's own name completes first and the ending says whose it is (corpus-doctor-mt).
#
# Scoped like the artifact guard: only NEWLY ADDED skills are checked. Existing skills are never
# flagged and never renamed (operator: new skills respect the convention; no estate-wide rename).
# The code is declared once in .claude/project-code (index copy if staged, else working tree).
#
# DISTRIBUTED_NAMES is the set this guard ships with. scripts/test-skill-naming.sh in
# syndicate-playbooks-examples pins it to the _project-template directory listing and fails the
# distribution preflight when they differ, so a new central skill can never be refused by the
# guard it is delivered with. `syndicate-*` is the central namespace (docs/terminology.md).
# ---------------------------------------------------------------------------
DISTRIBUTED_NAMES=" add-work central-sign-in check-aws consult-claude consult-codex distribute-defaults generate-architecture generate-phases naming-conventions open-work operational-mail overlay-check progress-check repo-hygiene server-report setup setup-workflow-only start-session syndicate-connect syndicate-request syndicate-refresh-remote unattended-check update-progress "

project_code() {
  local raw=""
  if git diff --cached --name-only -- .claude/project-code 2>/dev/null | grep -q .; then
    raw="$(git show ":.claude/project-code" 2>/dev/null)"
  elif [ -f .claude/project-code ]; then
    raw="$(cat .claude/project-code 2>/dev/null)"
  fi
  printf '%s' "$raw" | head -n1 | tr -d ' \t\r'
}

naming_violations=""
naming_code="$(project_code)"
naming_code_ok=0
printf '%s' "$naming_code" | grep -qE '^[a-z][a-z0-9]{1,7}$' && naming_code_ok=1
while IFS= read -r -d '' path; do
  name=""; parent=""
  case "$path" in
    .claude/skills/*/SKILL.md|.agents/skills/*/SKILL.md)
      parent="${path%/SKILL.md}"; name="${parent##*/}"
      case "${parent%/*}" in .claude/skills|.agents/skills) ;; *) continue ;; esac ;;
    .claude/commands/*.md)
      name="${path#.claude/commands/}"; case "$name" in */*) continue ;; esac
      parent="$path"; name="${name%.md}" ;;
    *) continue ;;
  esac
  # It existed before this commit (a re-add, a rename inside the directory): not a new skill.
  git cat-file -e "$BASE:$parent" 2>/dev/null && continue
  case "$DISTRIBUTED_NAMES" in *" $name "*) continue ;; esac
  case "$name" in syndicate-*) continue ;; esac
  if [ "$naming_code_ok" = 1 ]; then
    case "$name" in *-"$naming_code") continue ;; esac
    naming_violations="${naming_violations}  ${path}  (new skill '${name}' — name it '${name}-${naming_code}')
"
  else
    naming_violations="${naming_violations}  ${path}  (new skill '${name}' — this project has no valid .claude/project-code yet)
"
  fi
done < <(git diff --cached --name-only -z --diff-filter=A "$BASE" 2>/dev/null)

if [ -n "$naming_violations" ]; then
  {
    echo "COMMIT BLOCKED by .claude/hooks/pre-commit — skill naming."
    printf '%s' "$naming_violations"
    echo ""
    echo "A skill (or command) this project creates ends in its project code, so a reader can"
    echo "tell it from distributed skills and from ones the Claude installation brings. The"
    echo "code is a SUFFIX: the skill's own name stays first, so typing it still finds it."
    if [ "$naming_code_ok" = 1 ]; then
      echo "This project's code is '${naming_code}' (.claude/project-code)."
    else
      echo "Declare the code once — one line, 2-8 lowercase letters/digits, starting with a"
      echo "letter, usually the repo name's initials (models-trainer -> mt):"
      echo "  printf 'mt\\n' > .claude/project-code && git add .claude/project-code"
    fi
    echo "Existing skills are never flagged; only new ones. Rule: PROJECT_CHARTER.md § 12."
    echo "Override (audited): git commit --no-verify"
  } >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Skill frontmatter — a NOTE, never a refusal. Runs on every staged (added, copied, modified or
# renamed) skill or command file, scoped exactly as the naming check above.
#
# Why: hyl-media, 2026-08-23. A description split into adjacent quoted strings across lines
# unregistered a skill: it vanished from the executor's skill listing with no error anywhere, and
# nothing at commit time could have said so.
#
# Why not a YAML loader: PyYAML is not standard library on every host. And measured 2026-10-22, it
# rejects 5 frontmatters that Claude Code 2.1.308 lists: syndicate-playbooks-examples'
# .claude/skills syndicate-member-hosts, syndicate-estate-operations and
# syndicate-claude-account-switch, and two app-brm-manufacturing-products commands. Claude Code
# quotes such values before parsing, so a loader check would cry wolf. The awk below reads only
# the shape: description on one line, the line after it a key, the fence closed. It is POSIX awk,
# verified identical under mawk and gawk.
#
# Why a warning: a folded description (description: >) is valid YAML, and refusing a commit the
# executor accepts is the one mistake a guard may not make. Claude Code lists block scalars: on
# 2026-10-22 it listed, description in full, two synced skills whose description is one (| and >).
# So a note for that shape says Claude Code lists it and another executor may not. This block
# never changes the exit status, needs no python3, and says nothing about a file with no
# frontmatter or no description.
#
# Measured silent on all 764 SKILL.md and command files on this workstation, _project-template
# included. Re-measured 2026-10-22 when it landed, over a wider set (~/.claude, plugin caches and
# worktrees too): silent on all 1,194, under both mawk and gawk, at the paths this hook reads
# (direct children of skills/ and commands/). Deeper in ~/.claude, out of that scope, it notes 7,
# all valid YAML: six block scalars, the two synced skills above among them, and one plugin whose
# description starts on the next line.
# ---------------------------------------------------------------------------
FRONTMATTER_AWK='
{ sub(/\r$/, "") }
NR == 1 { if ($0 !~ /^---[ \t]*$/) exit; infm = 1; next }
/^---[ \t]*$/ { closed = 1; exit }
pending && /^[ \t]*$/ { next }
pending {
  if ($0 ~ /^[ \t]/) { print "description continues on the next line"; said = 1; exit }
  if ($0 !~ /^[A-Za-z0-9_-]+:/ && $0 !~ /^- / && $0 !~ /^#/) { print "description is followed by a line that is not a key"; said = 1; exit }
  pending = 0
}
/^description:/ {
  v = $0; sub(/^description:[ \t]*/, "", v)
  if (v == "" || v ~ /^[|>][-+0-9]*[ \t]*(#.*)?$/) { print "description is not on its own line"; said = 1; exit }
  pending = 1
}
END { if (infm && !closed && !said) print "frontmatter opens with --- and never closes" }
'
frontmatter_notes=""
while IFS= read -r -d '' path; do
  case "$path" in
    .claude/skills/*/SKILL.md|.agents/skills/*/SKILL.md)
      parent="${path%/SKILL.md}"
      case "${parent%/*}" in .claude/skills|.agents/skills) ;; *) continue ;; esac ;;
    .claude/commands/*.md)
      case "${path#.claude/commands/}" in */*) continue ;; esac ;;
    *) continue ;;
  esac
  fm_reason="$(git show ":$path" 2>/dev/null | awk "$FRONTMATTER_AWK" 2>/dev/null)"
  [ -n "$fm_reason" ] && frontmatter_notes="${frontmatter_notes}  ${path}: ${fm_reason}
"
done < <(git diff --cached --name-only -z --diff-filter=ACMR "$BASE" 2>/dev/null)

if [ -n "$frontmatter_notes" ]; then
  { echo "Skill frontmatter (staged) - notes; NOT blocking this commit:"
    printf '%s' "$frontmatter_notes"
    echo "An executor drops a skill whose frontmatter it cannot read from its skill listing, with"
    echo "no error anywhere. Keep description: on one line, as every distributed skill does, then"
    echo "confirm the skill is still listed (/update-progress Step 2a)."
    case "$frontmatter_notes" in *"description is not on its own line"*)
      echo "A block scalar (description: | or >) is valid YAML and Claude Code lists such a skill;"
      echo "another executor may not, which is why the one-line form is the one that travels." ;;
    esac; } >&2
fi

# ---------------------------------------------------------------------------
# progress.json integrity — runs ONLY when progress.json is staged.
#
# Scoped to the moment of writing, deliberately: a project whose file is ALREADY
# damaged can still commit everything else, and is stopped only when someone next
# writes that file. A guard that blocked every commit in an already-broken repo
# would be switched off within a day.
#
# Measured 2026-07-30 across 34 live projects: FIVE were already damaged and no
# check anywhere could see it — two with a whole phase appended outside the JSON
# document (committed in March, invisible for four months), three with duplicate
# keys that parse cleanly while silently dropping the other value. One of those
# reads a month-old state as current because two merges collided.
#
# Fails OPEN on missing tooling (no python3, no checker) and CLOSED on real
# corruption: blocking every commit because an interpreter is absent would be a
# worse failure than the one being prevented.
# ---------------------------------------------------------------------------
if git diff --cached --name-only 2>/dev/null | grep -qx 'progress.json'; then
  PG_CHECK="$(git rev-parse --show-toplevel 2>/dev/null)/.claude/skills/progress-check/progress_check.py"
  if [ -f "$PG_CHECK" ] && command -v python3 >/dev/null 2>&1; then
    if ! pg_out="$(python3 "$PG_CHECK" --staged --file progress.json --quiet 2>&1)"; then
      {
        echo "COMMIT BLOCKED by .claude/hooks/pre-commit — progress.json integrity."
        printf '%s\n' "$pg_out"
        echo ""
        echo "This checks the STAGED bytes, which is what would enter history."
        echo "It fails on three corruptions that lose data — a file that does not parse, a"
        echo "duplicate key (valid JSON that silently drops the other value), a repeated"
        echo "task id — and on the append-only rule: a task/phase (or an estate_notice marker)"
        echo "that existed in the last commit and is now gone — plus a NEW phase/task without"
        echo "authored_by and assigned_to. Mark tasks superseded; name author and owner on additions."
        echo "It also fails on the project-metadata contract: an unsubstituted {{TEMPLATE}} token"
        echo "left in root project/description/created_at, an unattended operation described only"
        echo "in part, a phase closed with no completion date, and current_task written as an"
        echo "object or a list instead of a task id. A parked (null) current_task is legitimate"
        echo "and is never reported. And on a declared-relations block the reader would discard:"
        echo "a version that is not 1, members that are not an array, a member with no relation"
        echo "word, one that names neither an origin nor a path, and one whose only locator is a"
        echo "path leading out of this repository. No relations block at all is always fine."
        echo "Shape, vocabulary and style are never enforced."
        echo ""
        echo "Fix the file, re-stage it, and commit again. Re-check by hand with:"
        echo "  python3 .claude/skills/progress-check/progress_check.py"
        echo "Override (audited, and you are committing known-damaged state):"
        echo "  git commit --no-verify"
      } >&2
      exit 1
    elif [ -n "$pg_out" ]; then
      # progress-check exited 0 and still had something to say. Warnings NEVER block — they are not
      # data loss — but until phase 31 they were also never printed: the hook showed $pg_out only in
      # the failure branch, and --quiet suppressed them at the source. A warning nobody sees at the
      # one moment it was written for (commit time) is a warning that does not exist.
      { echo "progress.json (staged) — progress-check notes; NOT blocking this commit:"
        printf '%s\n' "$pg_out"; } >&2
    fi
  fi
fi

# A newly-added file that looks like it holds a secret (the scan is in the loop above).
if [ -n "$secret_violations" ]; then
  {
    echo "COMMIT BLOCKED by .claude/hooks/pre-commit — a NEWLY-ADDED file looks like it holds a secret:"
    printf '%s' "$secret_violations"
    echo ""
    echo "A secret file stays out of git: history keeps it after the file is gone, and if it was"
    echo "ever pushed, rotation comes first. Rule: PROJECT_CHARTER.md § 8."
    echo "Unstage it (git restore --staged <path>) and gitignore it. A fake fixture or a file of"
    echo "public values goes in .claude/hooks/artifact-guard.allow, in this commit."
    echo "Override (audited): git commit --no-verify"
  } >&2
  exit 1
fi

if [ -n "$violations" ]; then
  {
    echo "COMMIT BLOCKED by .claude/hooks/pre-commit (framework commit guard)."
    echo "These NEWLY-ADDED files look like build artifacts or are oversize:"
    printf '%s' "$violations"
    echo "Build artifacts are regenerable and must never enter git history. This guard"
    echo "exists because a 'git add -A' once swept a 36MB lambda-deployment.zip onto a"
    echo "shared branch. Already-tracked files are NEVER blocked — only new adds."
    echo ""
    echo "To proceed, choose ONE:"
    echo "  1) Unstage it:       git restore --staged <path>   (then add it to .gitignore)"
    echo "  2) Intentional data: add a glob line to .claude/hooks/artifact-guard.allow,"
    echo "                       stage that change in THIS commit, then commit again"
    echo "  3) One-off override: git commit --no-verify   (audited; prefer #2 if recurring)"
    echo ""
    echo "Commit by named paths (git commit -- <files>), never 'git add -A'."
  } >&2
  exit 1
fi
exit 0
